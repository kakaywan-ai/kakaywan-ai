# Copy this file to .env and fill in values. NEVER commit .env

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
EMBED_MODEL=all-MiniLM-L6-v2

CHROMA_DIR=./chroma_db
# Cosine similarity needed for a chunk to count as evidence; tune on the eval set
MIN_SIMILARITY=0.35
TOP_K=4

PDF_PATH=./data/processed.pdf
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_DISTANCE_THRESHOLD=0.65
